---
import Page from '../../layouts/Page.astro';
import { legal, stagedLinks } from '../../navigation.ts';
import { exportedVersion } from '../../quote.ts';
const pages = stagedLinks(legal).map((page) => ({ ...page, version: exportedVersion(page.file) }));
---
<Page title="Legal" description="The legal texts of Strikta and Strikta Pro.">
	<h1>Legal</h1>
	<table class="compare documents">
		<thead><tr><th scope="col">Document</th><th scope="col">Status</th><th scope="col">Version</th></tr></thead>
		<tbody>
			{pages.map((page) => (
				<tr>
					<th scope="row"><a href={page.route}>{page.label}</a></th>
					<td data-label="Status"><span class="badge">{page.draft ? 'Draft, not in force' : 'In force'}</span></td>
					<td data-label="Version" class="version">{page.version}</td>
				</tr>
			))}
		</tbody>
	</table>
</Page>
<style>
	.documents a {
		display: inline-flex;
		align-items: center;
		min-block-size: var(--s-target);
	}
	.badge {
		display: inline-block;
		padding: var(--s-space-1) var(--s-space-2);
		border: var(--s-line-hair) solid var(--s-color-ink);
		font-size: var(--s-text-xs);
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.version {
		font-family: var(--s-font-mono);
		font-size: var(--s-text-sm);
	}
</style>
