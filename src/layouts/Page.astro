---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
type Props = { title?: string; description: string };
const { title, description } = Astro.props;
const heading = title === undefined ? 'Strikta' : `${title} · Strikta`;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{heading}</title>
		<meta name="description" content={description} />
		<meta name="referrer" content="no-referrer" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="stylesheet" href="/token.css" />
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<Header />
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>
<style is:global>
	@font-face {
		font-family: 'IBM Plex Sans';
		font-style: normal;
		font-weight: 400;
		font-display: swap;
		src: url('/font/IBMPlexSans-Regular-Latin1.woff2') format('woff2');
	}
	@font-face {
		font-family: 'IBM Plex Sans';
		font-style: normal;
		font-weight: 600;
		font-display: swap;
		src: url('/font/IBMPlexSans-SemiBold-Latin1.woff2') format('woff2');
	}
	@font-face {
		font-family: 'IBM Plex Mono';
		font-style: normal;
		font-weight: 400;
		font-display: swap;
		src: url('/font/IBMPlexMono-Regular-Latin1.woff2') format('woff2');
	}
	@font-face {
		font-family: 'IBM Plex Mono';
		font-style: normal;
		font-weight: 600;
		font-display: swap;
		src: url('/font/IBMPlexMono-SemiBold-Latin1.woff2') format('woff2');
	}
	:root {
		--sans: 'IBM Plex Sans', system-ui, sans-serif;
		--mono: 'IBM Plex Mono', ui-monospace, monospace;
		scroll-padding-block-start: 80px;
	}
	*,
	*::before,
	*::after {
		box-sizing: border-box;
		animation: none !important;
		transition: none !important;
		scroll-behavior: auto !important;
	}
	body {
		margin: 0;
		background: var(--bg);
		color: var(--ink);
		font-family: var(--sans);
		font-size: var(--base-size);
		line-height: var(--base-line);
	}
	main {
		max-inline-size: var(--grid-max);
		margin-inline: auto;
		padding: var(--space-7) var(--gutter) 0;
	}
	main:focus {
		outline: none;
	}
	h1 {
		margin-block: 0 var(--space-5);
		font-size: var(--h1-size);
		line-height: var(--h1-line);
		font-weight: 600;
	}
	h2 {
		margin-block: var(--space-8) var(--space-4);
		font-size: var(--h2-size);
		line-height: var(--h2-line);
		font-weight: 600;
	}
	h3 {
		font-size: var(--h3-size);
		line-height: var(--h3-line);
		font-weight: 600;
	}
	@media (max-width: 639px) {
		h1 {
			font-size: var(--mobile-hero-size);
			line-height: var(--mobile-hero-line);
		}
		h2 {
			font-size: var(--h3-size);
			line-height: var(--h3-line);
		}
	}
	p,
	ul,
	ol {
		margin-block: 0 var(--space-4);
	}
	a {
		color: var(--accent);
		text-underline-offset: 3px;
	}
	code {
		font-family: var(--mono);
		font-size: 0.9em;
	}
	:focus-visible {
		outline: 3px solid var(--focus);
		outline-offset: 2px;
	}
	.skip {
		position: absolute;
		inset-inline-start: var(--space-4);
		inset-block-start: -100px;
		z-index: 2;
		padding: var(--space-3) var(--space-4);
		background: var(--bg);
		color: var(--accent);
	}
	.skip:focus {
		inset-block-start: var(--space-4);
	}
	.prose {
		max-inline-size: 70ch;
	}
	.lead {
		font-size: var(--lg-size);
		line-height: var(--lg-line);
	}
	.muted {
		color: var(--muted);
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
		gap: var(--gutter);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		margin-block: var(--space-6);
	}
	.compare {
		inline-size: 100%;
		border-collapse: collapse;
	}
	.compare th,
	.compare td {
		padding: var(--space-3) var(--space-4);
		border: 1px solid var(--border);
		text-align: start;
		vertical-align: top;
	}
	.compare thead th {
		background: var(--surface);
	}
	@media (max-width: 639px) {
		.compare thead {
			position: absolute;
			inline-size: 1px;
			block-size: 1px;
			overflow: hidden;
			clip-path: inset(50%);
		}
		.compare,
		.compare tbody,
		.compare tr,
		.compare th,
		.compare td {
			display: block;
		}
		.compare tr {
			margin-block-end: var(--space-4);
			border: 1px solid var(--border);
			border-radius: var(--radius-md);
		}
		.compare th,
		.compare td {
			border: 0;
		}
		.compare td::before {
			display: block;
			content: attr(data-label);
			color: var(--muted);
			font-size: var(--sm-size);
		}
	}
	@media print {
		.header,
		.footer nav,
		.skip {
			display: none;
		}
	}
</style>
