{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended", ":dependencyDashboard", ":semanticCommits", "helpers:pinGitHubActionDigests"],
	"timezone": "Europe/Stockholm",
	"schedule": ["before 6am on monday"],
	"labels": ["dependencies"],
	"rangeStrategy": "pin",
	"packageRules": [
		{
			"description": "Astro, Starlight, TypeScript and Hono change the build or the service: one group, opened only on dashboard approval, never auto-merged.",
			"matchPackageNames": ["astro", "@astrojs/**", "typescript", "hono", "@hono/**"],
			"groupName": "framework",
			"dependencyDashboardApproval": true,
			"automerge": false
		},
		{
			"description": "Major version bumps are never auto-merged — they get a PR for review.",
			"matchUpdateTypes": ["major"],
			"automerge": false,
			"labels": ["dependencies", "major-bump"]
		},
		{
			"description": "GitHub Actions stay current — automerge minor + patch once the required check passes.",
			"matchManagers": ["github-actions"],
			"matchUpdateTypes": ["minor", "patch", "digest"],
			"automerge": true
		}
	],
	"vulnerabilityAlerts": {
		"enabled": true,
		"labels": ["security", "dependencies"]
	},
	"lockFileMaintenance": {
		"enabled": true,
		"schedule": ["before 6am on the first day of the month"]
	}
}
