---
import { help, legal, product, stagedLinks } from '../navigation.ts';
import { slot, slots } from '../slot.ts';
import Disclosure from './Disclosure.astro';
const columns = [
	{ title: 'Product', links: stagedLinks(product) },
	{ title: 'Help', links: stagedLinks(help) },
	{ title: 'Legal', links: stagedLinks(legal) }
];
const company = slot(slots, 'company.name');
---
<footer class="footer">
	<div class="inner">
		<div class="columns">
			{columns.map((column) => (
				<nav aria-label={column.title}>
					<h2 class="label">{column.title}</h2>
					<ul>
						{column.links.map((link) => <li><a href={link.route}>{link.label}</a></li>)}
					</ul>
				</nav>
			))}
		</div>
		<Disclosure />
		<p class="notice">
			Copyright (C) 2026 {company}. Strikta and the Strikta logo are trademarks of {company}. Hermes Agent, OpenClaw, Lossless Claw, Claude Code, Codex and other names belong to their owners and are used only to identify their products; Strikta is not affiliated with or endorsed by them.
		</p>
	</div>
</footer>
<style>
	.footer {
		margin-block-start: var(--s-space-10);
		border-block-start: var(--s-line-hair) solid var(--s-color-rule);
	}
	.inner {
		display: grid;
		gap: var(--s-space-6);
		padding: var(--s-space-7) var(--s-margin);
	}
	.columns {
		display: grid;
		grid-template-columns: repeat(var(--s-columns), minmax(0, 1fr));
		gap: var(--s-space-5) var(--s-gutter);
	}
	.columns nav {
		grid-column: span 2;
	}
	@media (min-width: 40rem) {
		.columns nav {
			grid-column: span 4;
		}
	}
	@media (min-width: 160rem) {
		.columns nav {
			grid-column: span 3;
		}
	}
	h2 {
		margin-block: 0 var(--s-space-2);
		color: var(--s-color-muted);
		font-family: var(--s-font-sans);
		letter-spacing: 0.08em;
	}
	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.columns a {
		display: inline-flex;
		align-items: center;
		min-block-size: var(--s-target);
		text-decoration: none;
	}
	.columns a:hover {
		text-decoration: underline;
	}
	.notice {
		max-inline-size: calc(var(--s-prose) * 2);
		margin: 0;
		color: var(--s-color-muted);
		font-size: var(--s-text-xs);
		line-height: var(--s-leading-body);
	}
</style>
