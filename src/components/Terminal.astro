---
// A rendered terminal frame: product output on synthetic data, scrolled inside a focusable, labelled region; `wrap` wraps window prose for display only.
type Props = { text: string; label: string; caption: string; wrap?: boolean };
const { text, label, caption, wrap } = Astro.props;
const STATUS = /(?<status>\[(?:ok {2}|FAIL|warn|info)\])/u;
const tones: Readonly<Record<string, string>> = { '[ok  ]': 'ok', '[FAIL]': 'fail', '[warn]': 'warn', '[info]': 'info' };
const runs = text.split(STATUS).map((run) => ({ run, tone: tones[run] }));
---
<figure class="frame">
	<pre class:list={['terminal scheme-dark', { wrap: wrap === true }]} tabindex="0" role="region" aria-label={label}><code>{runs.map(({ run, tone }) => (tone === undefined ? run : <span class={tone}>{run}</span>))}</code></pre>
	<figcaption class="caption">{caption}</figcaption>
</figure>
<style>
	.frame {
		display: grid;
		gap: var(--s-space-3);
		min-inline-size: 0;
		margin: 0;
	}
	.terminal {
		margin: 0;
		padding: var(--s-space-5);
		overflow-x: auto;
		border: var(--s-line-hair) solid var(--s-color-rule);
		background: var(--s-color-paper);
		color: var(--s-color-ink);
		font-family: var(--s-font-mono);
		font-size: var(--s-text-sm);
		line-height: var(--s-leading-mono);
		white-space: pre;
	}
	.wrap {
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
	code {
		font-size: 1em;
	}
	.fail {
		color: var(--s-color-fail);
		font-weight: 600;
	}
	.warn {
		color: var(--s-color-warn);
	}
	.info {
		color: var(--s-color-muted);
	}
	.terminal:focus-visible {
		outline-color: var(--s-color-ink);
	}
</style>
