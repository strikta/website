---
import { help, legal, product, stagedLinks } from '../navigation.ts';
import { slot, slots } from '../slot.ts';
import Disclosure from './Disclosure.astro';
const columns = [
	{ title: 'Product', links: stagedLinks(product) },
	{ title: 'Help', links: stagedLinks(help) },
	{ title: 'Legal', links: stagedLinks(legal) }
];
const company = slot(slots, 'company.name');
---
<footer class="footer">
	<div class="inner">
		<div class="columns">
			{columns.map((column) => (
				<nav aria-label={column.title}>
					<h2>{column.title}</h2>
					<ul>
						{column.links.map((link) => <li><a href={link.route}>{link.label}</a></li>)}
					</ul>
				</nav>
			))}
		</div>
		<Disclosure />
		<p class="notice">
			Copyright (C) 2026 {company}. Strikta and the Strikta logo are trademarks of {company}. Hermes Agent, OpenClaw, Lossless Claw, Claude Code, Codex and other names belong to their owners and are used only to identify their products; Strikta is not affiliated with or endorsed by them.
		</p>
	</div>
</footer>
<style>
	.footer {
		margin-block-start: var(--space-9);
		border-block-start: 1px solid var(--border);
		background: var(--surface);
	}
	.inner {
		display: grid;
		gap: var(--space-6);
		max-inline-size: var(--grid-max);
		margin-inline: auto;
		padding: var(--space-7) var(--gutter);
	}
	.columns {
		display: grid;
		grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
		gap: var(--gutter);
	}
	.columns nav {
		grid-column: span 4;
	}
	h2 {
		margin-block: 0 var(--space-2);
		font-size: var(--sm-size);
		line-height: var(--sm-line);
	}
	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.columns a {
		display: inline-flex;
		align-items: center;
		min-block-size: var(--target);
		color: var(--ink);
	}
	.notice {
		margin: 0;
		color: var(--muted);
		font-size: var(--xs-size);
		line-height: var(--xs-line);
	}
</style>
