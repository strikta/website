---
import { header, stagedLinks } from '../navigation.ts';
import Mark from './Mark.astro';
const links = stagedLinks(header);
const current = Astro.url.pathname.replace(/\/$/u, '') || '/';
---
<header class="header">
	<div class="bar">
		<a class="wordmark" href="/"><Mark size={32} decorative />strikta</a>
		<nav class="wide" aria-label="Main">
			<ul>
				{links.map((link) => <li><a href={link.route} aria-current={link.route === current ? 'page' : undefined}>{link.label}</a></li>)}
			</ul>
		</nav>
		<details class="menu">
			<summary>Menu</summary>
			<nav aria-label="Main">
				<ul>
					{links.map((link) => <li><a href={link.route} aria-current={link.route === current ? 'page' : undefined}>{link.label}</a></li>)}
				</ul>
			</nav>
		</details>
	</div>
</header>
<style>
	.header {
		position: sticky;
		inset-block-start: 0;
		z-index: 1;
		border-block-end: 1px solid var(--border);
		background: var(--bg);
	}
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-5);
		max-inline-size: var(--grid-max);
		min-block-size: 64px;
		margin-inline: auto;
		padding-inline: var(--gutter);
	}
	.wordmark {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
		min-block-size: var(--target);
		color: var(--ink);
		font-family: var(--mono);
		font-size: var(--lg-size);
		font-weight: 600;
		letter-spacing: -0.02em;
		text-decoration: none;
	}
	ul {
		display: flex;
		gap: var(--space-5);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	nav a {
		display: inline-flex;
		align-items: center;
		min-block-size: var(--target);
		color: var(--ink);
		text-decoration: none;
	}
	nav a:hover,
	nav a[aria-current='page'] {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 6px;
	}
	.menu {
		display: none;
	}
	@media (max-width: 639px) {
		.wide {
			display: none;
		}
		.menu {
			display: block;
		}
		summary {
			display: flex;
			align-items: center;
			min-block-size: var(--target);
			padding-inline: var(--space-4);
			border: 1px solid var(--input-border);
			border-radius: var(--radius-md);
			cursor: pointer;
		}
		.menu[open] nav {
			position: absolute;
			inset-inline: 0;
			inset-block-start: 64px;
			border-block-end: 1px solid var(--border);
			background: var(--bg);
		}
		.menu ul {
			flex-direction: column;
			gap: 0;
		}
		.menu a {
			min-block-size: 48px;
			padding-inline: var(--gutter);
			inline-size: 100%;
			box-sizing: border-box;
		}
	}
</style>
