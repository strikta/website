---
import Button from '../components/Button.astro';
import Callout from '../components/Callout.astro';
import Quote from '../components/Quote.astro';
import Page from '../layouts/Page.astro';
import { enquiry } from '../navigation.ts';
import { shown } from '../stage.ts';
const agpl = ['agpl-obligations', 'agpl-relief', 'agpl-relief-pro', 'agpl-relief-company', 'stays-agpl-1'];
const vat = [
	{ where: 'Sweden', treatment: '25% Swedish VAT' },
	{ where: 'EU business with a VIES-valid number', treatment: 'Reverse charge' },
	{ where: 'Outside the EU', treatment: 'Not subject to Swedish VAT; we ask for proof that you are a business' }
];
---
<Page title="Company licence" description="The Strikta company licence for businesses that embed Strikta in a product they ship, or run it as a service, without publishing their source.">
	<h1>The company licence</h1>
	<div class="prose">
		<p class="lead">For businesses that embed Strikta in a product they ship, or run it as a service, without publishing their source.</p>
		<p><Quote id="company-licence-offer" /></p>
		<div class="actions"><Button href={enquiry}>Email licensing@strikta.dev</Button></div>

		<Callout label="Before the first contracts">
			<p>We are taking enquiries now. The first contracts are signed once our contributor agreement process and a licence audit of our dependencies are complete; we will tell you where your enquiry stands when we reply.</p>
		</Callout>

		<h2>Who it is for and what it costs</h2>
		<p><Quote id="company-licence-buyers" /></p>
		{shown('/company-licence', 'company-licence-price') && <p><Quote id="company-licence-price" /></p>}
		<p>Annual, per product, quoted on request. Prices exclude VAT; invoices are due within 30 days.</p>
		<p>Businesses in the United States and Canada: enquiries are welcome; we confirm availability when we reply.</p>

		<h2>What it grants</h2>
		<p>A non-exclusive, annual licence, replacing AGPL-3.0, for one named legal entity and one named product or product family: use, modify, embed and distribute Strikta in that product under your own terms, and run it as a network service, without publishing source. Unlimited deployments of that product; every release published during the term; email support, best effort, with no service level; as-is warranty; liability capped at the fees paid in the 12 months before a claim, except for intent or gross negligence, use outside the licence, or where the law does not allow a cap.</p>

		<h2>What it does not grant</h2>
		<p>Reselling Strikta on its own or as a competing hosted memory service; the Strikta name and logo (see <a href="/legal/trademarks">the trademark policy</a>); the Pro Console; other products.</p>

		<h2>Term</h2>
		<p><Quote id="company-licence-6.1" /></p>

		<h2>If you stop</h2>
		<p>Copies already delivered and deployments already running continue. Without renewing, you may not ship new versions containing Strikta, start new deployments, or use releases published after your term.</p>

		<h2>If we stop</h2>
		<p><Quote id="company-licence-6.4" /></p>

		<h2>VAT</h2>
		<table class="compare">
			<thead><tr><th scope="col">Where your business is</th><th scope="col">VAT on the invoice</th></tr></thead>
			<tbody>
				{vat.map((row) => <tr><td data-label="Where your business is">{row.where}</td><td data-label="VAT on the invoice">{row.treatment}</td></tr>)}
			</tbody>
		</table>
		<p class="note">EU businesses without a valid VAT number: we confirm the VAT treatment before quoting.</p>

		<h2>The AGPL and the company licence</h2>
		{agpl.map((entry) => <p><Quote id={entry} /></p>)}

		<h2>Names</h2>
		<p>You may say publicly that you use Strikta. We never name a customer without written consent.</p>

		<h2>Who licenses it</h2>
		<p><Quote id="company-identity" /></p>
		<p>The full text: <a href="/legal/company-licence">Strikta Commercial Licence</a>.</p>
	</div>
</Page>
<style>
	.note {
		margin-block-start: var(--space-4);
	}
</style>
