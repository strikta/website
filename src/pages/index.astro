---
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Code from '../components/Code.astro';
import Hero from '../components/Hero.astro';
import Limits from '../components/Limits.astro';
import Inspect from '../components/Inspect.astro';
import Quote from '../components/Quote.astro';
import Rebuilt from '../components/Rebuilt.astro';
import Section from '../components/Section.astro';
import Terminal from '../components/Terminal.astro';
import { findTurn, loadDemo, loadReplay } from '../diagram.ts';
import Page from '../layouts/Page.astro';
import { enquiry } from '../navigation.ts';
import { slot, slots } from '../slot.ts';
import { released, staged } from '../stage.ts';
const root = process.cwd();
const replay = loadReplay(root);
const installed = staged('/docs');
const compared = staged('/head-to-head');
const rows = [
	{ name: 'system', text: "Your agent's own instructions.", shown: true },
	{ name: 'rules', text: `Standing rules: lasting instructions such as 'always answer in metric units', kept per user and rendered every turn.${released('rules_default') ? '' : ' On in the chatbot preset.'}`, shown: true },
	{ name: 'situation', text: 'Open matters, one dated line each, so the agent knows what is still in progress.', shown: released('situation') },
	{ name: 'profile', text: 'What is known about the user.', shown: true },
	{ name: 'retrieved', text: 'Memories and facts chosen for this message, each with its date. A corrected fact is closed with an end date, not deleted.', shown: true },
	{ name: 'conversation', text: 'The most recent exchanges, verbatim.', shown: true },
	{ name: 'message', text: 'The message being answered.', shown: true }
].filter((row) => row.shown);
// From S2 the section shows real `strikta inspect-turn` output; until then the hand-drawn candidates of the synthetic turn.
const output = installed ? loadDemo(root, 'inspect-turn.txt') : undefined;
const candidates = findTurn(root, replay.to)
	.candidates.map(({ id, served, stage, text }) => `${served ? '■' : '□'} ${id.padEnd(11)}${(served ? 'served' : `dropped at ${stage ?? '-'}`).padEnd(18)}${text ?? ''}`.trimEnd())
	.join('\n');
const egress = [
	{ stays: 'The memory store, the audit log, the configuration', sent: "Every stored turn's text, to the generation provider you configure (Gemini by default), for extraction and consolidation" },
	{ stays: 'Embeddings of your messages (local multilingual E5 model)', sent: 'The current message, for some model calls such as temporal query decomposition' },
	{ stays: 'No telemetry: Strikta and Strikta Pro upload nothing to us', sent: 'Pro alert notices, only if you turn them on, to the destination you choose; never memory content' }
];
const parts = ['rebuilt', 'window', 'inspect', 'egress', 'runtimes', 'limits'];
/** A section's number in the order this stage shows the sections. */
const numbered = (part: string): string => String(parts.indexOf(part) + 1).padStart(2, '0');
---
<Page description="Strikta, an open-source context engine for LLM agents, rebuilds the context window before every request from verbatim history and never summarises it." code={installed}>
	<Hero />

	<Section id="rebuilt" number={numbered('rebuilt')} label="Rebuilt every turn" title="The window is rebuilt before every request">
		<Rebuilt />
	</Section>

	<Section id="window" number={numbered('window')} label="The window" title="What goes into the window">
		<dl class="rows">
			{rows.map((row) => <div><dt>{row.name}</dt><dd>{row.text}</dd></div>)}
		</dl>
		<p class="prose muted">Dates stay attached: the window tells the model that 'yesterday' in a memory means the day before that memory's date, and to write absolute dates.</p>
	</Section>

	<Section id="inspect" number={numbered('inspect')} label="Inspect" title="Inspect any turn">
		{output !== undefined && <p class="prose"><code>strikta inspect-turn</code> prints one assembled turn: each section with its byte range and origin, every candidate with its score terms and the stage that dropped it, and stage timings.</p>}
		<Inspect />
		{output === undefined
			? <Terminal text={candidates} label={`Candidates for turn ${replay.to}`} caption={`Candidates for turn ${replay.to}: ■ served, □ dropped, with the stage that dropped it. Synthetic persona.`} />
			: <Terminal text={output} label={`strikta inspect-turn ${replay.to}`} caption="Real output of strikta inspect-turn on a synthetic persona. No real user data." />}
	</Section>

	<Section id="egress" number={numbered('egress')} label="Egress" title="What leaves your machine">
		<table class="compare">
			<thead><tr><th scope="col">Stays on your machine</th><th scope="col">Is sent out</th></tr></thead>
			<tbody>
				{egress.map((row) => <tr><td data-label="Stays on your machine">{row.stays}</td><td data-label="Is sent out">{row.sent}</td></tr>)}
			</tbody>
		</table>
		<p class="prose">To keep all processing on your machine, point Strikta at a local OpenAI-compatible server (Ollama, vLLM or llama.cpp) for generation, and leave reranking off. Reranking is off in the production presets.</p>
	</Section>

	<Section id="runtimes" number={numbered('runtimes')} label="Runtimes" title="Works with your agent">
		<div class="cards">
			<Card title="Hermes Agent"><p>Context engine and memory provider in one plugin. Hermes 0.22.5 and later 0.22 releases.</p></Card>
			<Card title="OpenClaw"><p>A context engine plugin with no summariser. OpenClaw 2026.9.33 and 2026.10.7, Node.js 24 or newer.</p></Card>
			<Card title="Claude Code and Codex"><p>Hooks capture each exchange before Claude Code compacts and re-ground the session after it; an MCP server gives the same memory to any MCP client.</p></Card>
		</div>
		{installed ? (
			<div class="install">
				<Code text={slot(slots, 'install.daemon')} label="Install the Strikta daemon" />
				<p class="prose">Needs Docker and an API key for a generation provider (Gemini by default), or a local model server for fully local processing.</p>
			</div>
		) : (
			<p class="muted">Quickstart published with the first release.</p>
		)}
	</Section>

	<Section id="limits" number={numbered('limits')} label="Limits" title="Known limits">
		<Limits>
			<li>Every request waits for assembly; <code>strikta inspect-turn</code> shows how long each stage took on your machine.</li>
			<li>Extraction sends stored turn text to your generation provider unless you run a local model server.</li>
			<li>On Hermes, Hermes's compressor still runs; the journal shows when its summary reaches the model.</li>
			<li>The OpenClaw plugin is beta.</li>
			<li>Setup needs Docker.</li>
			{!compared && <li>No comparison with other memory systems has been published yet.</li>}
		</Limits>
	</Section>

	<div class="closing">
		<section class="pro" aria-labelledby="pro">
			<h2 id="pro">Strikta Pro: the Console for what your agent sees</h2>
			<p class="prose">A local web app over your own engine: the exact window of every turn, every candidate with its score terms, corrections with a preview and undo, health and alerts. It sends nothing to us.</p>
			<p class="prose"><strong>On sale from the public launch.</strong></p>
			<Button href="/pro" quiet>About Strikta Pro</Button>
		</section>
		<p class="licence prose"><Quote id="company-licence-offer" /> <a href={enquiry}>licensing@strikta.dev</a> · <a href="/company-licence">How the company licence works</a></p>
	</div>
</Page>
<style>
	.rows {
		margin: 0;
	}
	.rows div {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--s-space-1) var(--s-gutter);
		padding-block: var(--s-space-3);
		border-block-end: var(--s-line-hair) solid var(--s-color-rule);
	}
	.rows div:first-child {
		border-block-start: var(--s-line-hair) solid var(--s-color-ink);
	}
	dt {
		font-family: var(--s-font-mono);
		font-size: var(--s-text-sm);
	}
	dd {
		max-inline-size: var(--s-prose);
		margin: 0;
	}
	.cards {
		display: grid;
		grid-template-columns: subgrid;
		row-gap: var(--s-space-6);
	}
	@media (min-width: 160rem) {
		.cards > :global(.card:last-child) {
			grid-column: span 3;
		}
	}
	.install {
		display: grid;
		gap: var(--s-space-4);
	}
	.closing {
		display: grid;
		grid-template-columns: repeat(var(--s-columns), minmax(0, 1fr));
		gap: var(--s-space-6) var(--s-gutter);
		margin-block-start: var(--s-space-9);
	}
	.pro,
	.licence {
		grid-column: 1 / -1;
	}
	.pro {
		padding: var(--s-space-6);
		border: var(--s-line-hair) solid var(--s-color-ink);
	}
	.pro h2 {
		margin-block-start: 0;
	}
	.licence {
		margin: 0;
	}
	@media (min-width: 40rem) {
		.rows {
			display: grid;
			grid-template-columns: max-content minmax(0, 1fr);
			column-gap: var(--s-gutter);
		}
		.rows div {
			grid-column: 1 / -1;
			grid-template-columns: subgrid;
		}
	}
	@media (min-width: 64rem) {
		.pro,
		.licence {
			grid-column: 5 / -1;
		}
	}
	@media (min-width: 160rem) {
		.pro,
		.licence {
			grid-column: 6 / span 9;
		}
	}
</style>
