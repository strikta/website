---
type Props = { label?: string };
const { label } = Astro.props;
---
<aside class="callout" aria-label={label}>
	<slot />
</aside>
<style>
	.callout {
		max-inline-size: var(--s-prose);
		margin-block: var(--s-space-6);
		padding-inline-start: var(--s-space-4);
		border-inline-start: var(--s-line-strong) solid var(--s-color-ink);
	}
	.callout :global(p) {
		margin: 0;
	}
</style>
