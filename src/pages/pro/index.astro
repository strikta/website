---
import Callout from '../../components/Callout.astro';
import Quote from '../../components/Quote.astro';
import Page from '../../layouts/Page.astro';
const features = [
	{ title: 'See the exact window', text: 'The Turn inspector shows the assembled window exactly as the model received it, which memory or fact each span came from, every candidate with its score terms (shown as total = parts), why each rejected candidate was rejected, and stage timings.' },
	{ title: 'Correct what it remembers', text: 'Retract a fact that was born wrong, end one that stopped being true, correct, pin, suppress or erase. Each change shows a dry-run preview first, and every change except erase can be undone.' },
	{ title: 'Know when something breaks', text: 'Latency by domain, consolidation progress with pause and cancel, watcher heartbeats, failed stores and provider errors, with alerts to ntfy, Telegram or an email webhook.' },
	{ title: 'Browse a large memory', text: 'Facts, entities and stored turns, searched through the engine, built for stores of hundreds of thousands of facts.' },
	{ title: 'Control capture and see egress', text: 'Pause capture, exclude projects, set each domain\'s audit mode, and see which calls left your machine in the last 24 hours, to which provider, for what purpose. Replay any turn as a dry run and compare it with the original.' }
];
const comparison: readonly { capability: string; command?: string; free: string; pro: string }[] = [
	{ capability: 'Context rebuilt every turn', free: 'Yes', pro: 'Yes' },
	{ capability: 'Inspect a turn', command: 'strikta inspect-turn', free: 'admin API', pro: 'Interactive inspector' },
	{ capability: 'Replay', free: 'Admin API', pro: 'Replay/Diff view' },
	{ capability: 'Retract, end, correct, pin, suppress, erase', free: 'Admin API', pro: 'Dry-run preview and undo' },
	{ capability: 'Health and alerts', command: 'strikta doctor', free: 'admin API', pro: 'Dashboard and alerts' },
	{ capability: 'Licence', free: 'AGPL-3.0-only', pro: 'Own use without AGPL obligations' }
];
---
<Page title="Strikta Pro" description="Strikta Pro: the Console that shows the exact context your agent was given each turn and lets you correct what it remembers.">
	<h1>Strikta Pro</h1>
	<p class="lead prose">The Pro Console shows the exact context your agent was given each turn, explains why each item is there, and lets you correct what it remembers. It runs beside your own engine and sends nothing to us.</p>
	<Callout label="Availability"><p>Strikta Pro goes on sale at the public launch. The price and the founding offer are published then.</p></Callout>

	<section aria-labelledby="included">
		<h2 id="included">What you get</h2>
		<p class="prose">Strikta Pro includes the Pro Console; a licence to use the Strikta engine for your own work without the AGPL's obligations; email support from the maintainer; and every update published while your licence is current. If your licence lapses, the Console keeps working and you still receive security releases.</p>
	</section>

	<section aria-labelledby="console">
		<h2 id="console">The Console</h2>
		<div class="prose">
			{features.map((feature) => (
				<>
					<h3>{feature.title}</h3>
					<p>{feature.text}</p>
				</>
			))}
		</div>
	</section>

	<section aria-labelledby="free-vs-pro">
		<h2 id="free-vs-pro">Free vs Pro</h2>
		<p class="prose"><Quote id="free-engine" /></p>
		<table class="compare">
			<thead><tr><th scope="col">Capability</th><th scope="col">Free engine</th><th scope="col">Strikta Pro</th></tr></thead>
			<tbody>
				{comparison.map((row) => <tr><th scope="row">{row.capability}</th><td data-label="Free engine">{row.command !== undefined && <><code>{row.command}</code>, </>}{row.free}</td><td data-label="Strikta Pro">{row.pro}</td></tr>)}
			</tbody>
		</table>
	</section>

	<p class="prose more">Using Strikta in a product you ship or run as a service? See <a href="/company-licence">the company licence</a>.</p>
</Page>
<style>
	.more {
		margin-block-start: var(--space-7);
	}
</style>
